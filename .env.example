# All configuration is server-side (nothing NEXT_PUBLIC_*). Copy to .env.local.

# Authentication: "identity" online (E:DEN SSO); offline, leave empty
# (local-dev: no login, loopback only).
PLANNER_AUTH_MODE=
EDEN_IDENTITY_BASE_URL=
EDEN_IDENTITY_APP_ID=planner
PLANNER_PUBLIC_URL=
PLANNER_SESSION_SECRET=

# Planner-owned database (server-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Later phases (server-only).
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MUTATIONS_REQUIRE_APPROVAL=true
