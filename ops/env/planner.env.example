# /etc/eden/planner-<production|preview>.env — root-owned, mode 0600.
# Never commit or print real values. One file per environment.

PLANNER_AUTH_MODE=identity
EDEN_IDENTITY_BASE_URL=https://auth.e-den.tech
EDEN_IDENTITY_APP_ID=planner
PLANNER_PUBLIC_URL=https://planner.e-den.tech
# 48+ random bytes, e.g. `openssl rand -base64 48`; different per environment.
PLANNER_SESSION_SECRET=

# The SQLite database path is set by the systemd unit
# (/var/lib/eden/planner-<env>/planner.sqlite3); no database credential exists.

# Trello (Planner -> Trello only). Key and token of a dedicated E:DEN service
# account that is a member of the board; the token needs read,write scope.
TRELLO_API_KEY=
TRELLO_API_TOKEN=
# Board id or short link of https://trello.com/b/9n93W4ym/eden
TRELLO_BOARD_ID=9n93W4ym
AI_MUTATIONS_REQUIRE_APPROVAL=true
